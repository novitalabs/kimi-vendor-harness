# Copy to .env and fill locally. Never commit .env.
KIMI_BASE_URL=https://example.invalid/v1
KIMI_API_KEY=replace-me
KIMI_MODEL=kimi-k3
K3_REPORT_DIR=reports/local
# Optional gateway routing headers, as a JSON object.
KIMI_EXTRA_HEADERS_JSON={}
# Optional observability endpoint for token-category checks.
KIMI_METRICS_URL=
KIMI_TRACE_HEADER=traceparent
KIMI_DEPLOY_ID_HEADER=X-Msh-ProviderDeployId
K3_SOURCE_COMMIT=
K3_DEPLOYMENT_ID=
K3_RUNTIME_ID=
K3_SERVE_ARGS_FILE=
