# Source a private shell file; the harness does not auto-load .env files.
# Endpoint/model/think_mode belong in service-access.json, not environment variables.
export KIMI_API_KEY=replace-me
export NVST_RESULTS_ROOT="$HOME/.cache/kimi-agentic-harness/runs"
# Optional wire cap field (default: max_tokens):
# export NVST_TOKEN_PARAM=max_completion_tokens
