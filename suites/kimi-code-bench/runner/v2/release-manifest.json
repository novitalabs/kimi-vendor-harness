{
  "release": "novita-kimi-code-bench-v1.1.0",
  "runner_version": "1.1.0",
  "stability": "stable",
  "release_date": "2026-09-10",
  "run_contract_schema": 2,
  "artifact_contract_version": "1.0",
  "metrics_contract_version": "1.0",
  "recording_schema_version": 2,
  "runtime_cache_schema_version": 1,
  "execution_profile": "official_observed",
  "official_observed_execution": {
    "schedule": "task_pipelines",
    "concurrency_scope": "task_count",
    "per_task_concurrency": 1,
    "harbor_n_attempts": 1,
    "harbor_timeout_multipliers": {
      "timeout_multiplier": 1.0,
      "agent_timeout_multiplier": 10.0,
      "verifier_timeout_multiplier": 10.0,
      "agent_setup_timeout_multiplier": 1.0,
      "environment_build_timeout_multiplier": 10.0
    },
    "kimi_loop_control": {
      "max_retries_per_step": 10,
      "max_steps_per_run": 500
    }
  },
  "supported_modes": ["smoke", "extended"],
  "scope": "Observed execution and artifact parity derived from the supplied official sample",
  "limitations": [
    "No claim of source-level parity with the unpublished official framework",
    "Task and MCP behavior remain the pinned local Terminal Bench 2 behavior",
    "Proxy arrival timing is a socket-read upper bound, not exact token ITL",
    "Gateway-shaped identities are generated by the local runner"
  ]
}
