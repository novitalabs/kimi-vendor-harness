{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "timestamp", "event", "run_id", "suite_id", "phase", "data", "writer"],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "event": {"enum": ["run_started", "preflight_completed", "suite_started", "progress_updated", "retry_scheduled", "service_degraded", "checkpoint_written", "pause_requested", "resume_requested", "stop_requested", "suite_completed", "run_completed", "run_interrupted", "supervisor_reconciled", "run_continuation_started"]},
    "run_id": {"type": "string", "minLength": 1},
    "suite_id": {"type": ["string", "null"]},
    "phase": {"type": ["string", "null"]},
    "data": {"type": "object"},
    "writer": {"type": "string", "minLength": 1}
  }
}
