{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doctor-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "status", "zero_vendor_traffic", "profile_hashes", "checks", "blocked_checks"],
  "properties": {
    "schema_version": {"const": 1},
    "model": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "blocked"]},
    "zero_vendor_traffic": {"type": "boolean"},
    "profile_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "reason", "details"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "blocked"]},
          "reason": {"type": ["string", "null"]},
          "details": {"type": "object"}
        }
      }
    },
    "blocked_checks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
