{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "model", "profile_status", "profile_notes", "repeat", "enabled_features", "concurrency", "retries", "request_budget", "max_output_tokens_budget", "profile_sha256", "cases", "producer", "target", "execution", "units", "plan_sha256", "inputs", "executable", "opt_in_cases", "contract_authority"],
  "properties": {
    "schema_version": {"const": 3},
    "kind": {"const": "endpoint_plan"},
    "status": {"const": "ready"},
    "model": {"type": "string"},
    "profile_status": {"enum": ["ready", "provisional"]},
    "profile_notes": {"type": "array", "items": {"type": "string"}},
    "repeat": {"type": "integer", "minimum": 1},
    "enabled_features": {"type": "array", "items": {"type": "string"}},
    "concurrency": {"const": 1},
    "retries": {"const": 0},
    "request_budget": {"type": "integer", "minimum": 0},
    "max_output_tokens_budget": {"type": "integer", "minimum": 0},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array",
      "items": {
        "$ref": "capability-case.schema.json#/$defs/case",
        "unevaluatedProperties": false,
        "required": ["file", "request_budget", "scope", "planned_requests", "required_features", "missing_requirements", "obligation"],
        "properties": {
          "file": {"type": "string"},
          "request_budget": {"type": "integer", "minimum": 0},
          "planned_requests": {"type": "integer", "minimum": 0},
          "required_features": {"type": "array", "items": {"type": "string"}},
          "missing_requirements": {"type": "array", "items": {"type": "string"}},
          "obligation": {"enum": ["required", "optional", "unknown", "not_applicable"]}
        }
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "source_sha256"],
      "properties": {"version": {"type": "string"}, "source_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "target": {"anyOf": [{"$ref": "service-access.schema.json"}, {"type": "null"}]},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["token_parameter", "timeout_seconds", "max_response_bytes", "max_requests", "network_env_sha256"],
      "properties": {
        "token_parameter": {"enum": ["max_tokens", "max_completion_tokens"]},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_response_bytes": {"const": 16777216},
        "max_requests": {"type": "integer", "minimum": 0},
        "network_env_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "repeat", "group", "step", "mode", "request_sha256", "expect_sha256", "binding_sha256"],
        "properties": {
          "id": {"type": "string"},
          "repeat": {"type": "integer", "minimum": 0},
          "group": {"type": "integer", "minimum": 0},
          "step": {"type": "integer", "minimum": 0},
          "mode": {"enum": ["stream", "nonstream"]},
          "request_sha256": {"$ref": "#/$defs/sha256"},
          "expect_sha256": {"$ref": "#/$defs/sha256"},
          "binding_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "inputs": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "executable": {"type": "boolean"},
    "opt_in_cases": {"type": "array", "items": {"type": "string"}},
    "contract_authority": {"$ref": "capability-profile.schema.json#/properties/authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
