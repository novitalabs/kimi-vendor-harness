{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3
    },
    "kind": {
      "const": "endpoint_plan"
    },
    "status": {
      "const": "ready"
    },
    "model": {
      "type": "string"
    },
    "profile_status": {
      "enum": [
        "ready",
        "provisional"
      ]
    },
    "profile_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "enabled_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concurrency": {
      "const": 1
    },
    "retries": {
      "const": 0
    },
    "request_budget": {
      "type": "integer",
      "minimum": 0
    },
    "max_output_tokens_budget": {
      "type": "integer",
      "minimum": 0
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "capability",
          "tags",
          "source",
          "knowledge",
          "likely_components",
          "determinism",
          "role",
          "stage",
          "modes",
          "max_output_tokens",
          "steps",
          "file",
          "request_budget",
          "scope",
          "planned_requests",
          "required_features",
          "missing_requirements",
          "obligation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-z_]+(?:/[a-z_]+)*$"
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "adaptation"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "test": {
                "type": "string"
              },
              "adaptation": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "knowledge": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "likely_components": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scope": {
            "const": "endpoint"
          },
          "determinism": {
            "enum": [
              "contract",
              "behavioral",
              "observation",
              "oracle"
            ]
          },
          "role": {
            "enum": [
              "gate",
              "diagnostic",
              "observation",
              "platform"
            ]
          },
          "stage": {
            "enum": [
              "protocol",
              "tooling",
              "conversation",
              "robustness",
              "regression"
            ]
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "stream",
                "nonstream"
              ]
            }
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/step"
            }
          },
          "file": {
            "type": "string"
          },
          "request_budget": {
            "type": "integer",
            "minimum": 0
          },
          "planned_requests": {
            "type": "integer",
            "minimum": 0
          },
          "required_features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "obligation": {
            "enum": [
              "required",
              "optional",
              "unknown",
              "not_applicable"
            ]
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "source_sha256"
      ]
    },
    "target": {
      "anyOf": [
        {
          "$ref": "service-access.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_parameter": {
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ]
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_response_bytes": {
          "const": 16777216
        },
        "max_requests": {
          "type": "integer",
          "minimum": 0
        },
        "network_env_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "token_parameter",
        "timeout_seconds",
        "max_response_bytes",
        "max_requests",
        "network_env_sha256"
      ]
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "repeat": {
            "type": "integer",
            "minimum": 0
          },
          "group": {
            "type": "integer",
            "minimum": 0
          },
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "enum": [
              "stream",
              "nonstream"
            ]
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expect_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "binding_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "repeat",
          "group",
          "step",
          "mode",
          "request_sha256",
          "expect_sha256",
          "binding_sha256"
        ]
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "executable": {
      "type": "boolean"
    },
    "opt_in_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "encoder",
        "tokenizer",
        "api_contract",
        "stream_protocol",
        "unknowns"
      ],
      "properties": {
        "checkpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoder": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokenizer": {
          "type": [
            "string",
            "null"
          ]
        },
        "api_contract": {
          "type": [
            "string",
            "null"
          ]
        },
        "stream_protocol": {
          "enum": [
            "kimi-stream-244",
            null
          ]
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "status",
    "model",
    "profile_status",
    "profile_notes",
    "repeat",
    "enabled_features",
    "concurrency",
    "retries",
    "request_budget",
    "max_output_tokens_budget",
    "profile_sha256",
    "cases",
    "producer",
    "target",
    "execution",
    "units",
    "plan_sha256",
    "inputs",
    "executable",
    "opt_in_cases",
    "contract_authority"
  ],
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expect"
      ],
      "oneOf": [
        {
          "required": [
            "request"
          ],
          "not": {
            "required": [
              "request_fixture"
            ]
          }
        },
        {
          "required": [
            "request_fixture"
          ],
          "not": {
            "required": [
              "request"
            ]
          }
        }
      ],
      "properties": {
        "request": {
          "type": "object"
        },
        "request_fixture": {
          "type": "string"
        },
        "message_slice": {
          "type": "integer",
          "minimum": 1
        },
        "continue_from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "tool_results",
            "call_count"
          ],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "call_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "tool_results": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "content"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "mode": {
          "enum": [
            "stream",
            "nonstream"
          ]
        },
        "thinking": {
          "type": "boolean"
        },
        "effort": {
          "type": "string"
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "error_object": {
              "type": "boolean"
            },
            "public_turn": {
              "type": "boolean"
            },
            "tools": {
              "enum": [
                "required",
                "none",
                "allowed"
              ]
            },
            "arguments_json": {
              "type": "boolean"
            },
            "first_call_only": {
              "type": "boolean"
            },
            "arguments_nonempty": {
              "type": "boolean"
            },
            "tool_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "arguments_schema": {
              "type": "object"
            },
            "content_json": {
              "enum": [
                "object",
                "any"
              ]
            },
            "content_schema": {
              "type": "object"
            },
            "no_empty_key": {
              "type": "boolean"
            },
            "reasoning": {
              "type": "boolean"
            },
            "usage": {
              "type": "boolean"
            },
            "usage_details": {
              "type": "boolean"
            },
            "max_completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "allow_truncation": {
              "type": "boolean"
            },
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "same_prompt_as": {
              "type": "integer",
              "minimum": 0
            },
            "minimum_prompt_delta": {
              "type": "integer"
            },
            "no_marker_leak": {
              "type": "boolean"
            },
            "stream_shape": {
              "type": "boolean"
            },
            "finish_reason": {
              "type": "string"
            },
            "max_calls": {
              "type": "integer",
              "minimum": 0
            },
            "id_min_suffix": {
              "type": "integer",
              "minimum": 0
            },
            "forbidden_arguments": {
              "type": "string"
            },
            "content_contains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
