{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["id","request","authority","expected_token_ids"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "request":{"type":"object","required":["messages"],"properties":{"messages":{"type":"array","minItems":1}}},
    "authority":{"type":"object","additionalProperties":false,"required":["checkpoint_revision","encoder_sha256","tokenizer_sha256","fixture_source"],"properties":{
      "checkpoint_revision":{"type":"string","minLength":1},
      "encoder_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "tokenizer_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "fixture_source":{"type":"string","minLength":1}
    }},
    "expected_token_ids":{"type":"array","minItems":1,"items":{"type":"integer","minimum":0}}
  }
}
