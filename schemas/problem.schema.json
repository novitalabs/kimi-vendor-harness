{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "message": {
      "type": "string"
    },
    "expected": {},
    "actual": {},
    "path": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "integer"
        ]
      }
    }
  },
  "required": [
    "code",
    "message",
    "expected",
    "actual",
    "path"
  ]
}
