{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deepswe-checkpoint.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "updated_by", "mode", "stamp", "task_names", "rounds", "max_reruns", "concurrency", "max_concurrency", "agent_timeout_multiplier", "round_scheduling", "max_parts_per_wave", "waves", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "updated_by": {"type": "string", "minLength": 1},
    "mode": {"enum": ["smoke", "subset", "full"]},
    "stamp": {"type": "string", "minLength": 1},
    "task_names": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "rounds": {"type": "integer", "minimum": 1},
    "max_reruns": {"type": "integer", "minimum": 0},
    "concurrency": {"type": "integer", "minimum": 1},
    "max_concurrency": {"type": "integer", "minimum": 1},
    "agent_timeout_multiplier": {"type": "number", "exclusiveMinimum": 0},
    "round_scheduling": {"const": "mixed_round_task_locked"},
    "max_parts_per_wave": {"type": "integer", "minimum": 1},
    "waves": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}}},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
