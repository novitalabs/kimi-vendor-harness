{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service-access.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_family", "base_url", "served_model", "api_key_env", "headers", "think_mode", "deployment_id", "runtime_id"],
  "properties": {
    "model_family": {"type": "string", "minLength": 1},
    "base_url": {"type": "string", "pattern": "^https?://"},
    "served_model": {"type": "string", "minLength": 1},
    "api_key_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "headers": {"type": "object", "additionalProperties": {"type": "string"}},
    "think_mode": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "runtime_id": {"type": "string", "minLength": 1},
    "source_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "worktree"],
        "properties": {
          "repo": {"type": "string"},
          "worktree": {"type": "string"},
          "branch": {"type": ["string", "null"]},
          "commit": {"type": ["string", "null"]},
          "log_entrypoints": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
