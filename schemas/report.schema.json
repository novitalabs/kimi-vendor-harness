{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "endpoint_report"
    },
    "status": {
      "enum": [
        "passed",
        "observed",
        "failed",
        "incomplete",
        "service_invalid",
        "execution_invalid"
      ]
    },
    "model": {
      "type": "string"
    },
    "run_dir": {
      "type": "string"
    },
    "plan_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned_requests": {
      "type": "integer",
      "minimum": 0
    },
    "actual_requests": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "case-result.schema.json"
      }
    },
    "disclaimer": {
      "type": "string"
    },
    "gate_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required_cases",
        "failures",
        "gaps",
        "result_counts",
        "role_counts",
        "scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "incomplete",
            "not_selected"
          ]
        },
        "required_cases": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "role_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "scenario_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "target": {
      "$ref": "service-access.schema.json"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "status",
    "model",
    "run_dir",
    "plan_sha256",
    "stop_reason",
    "planned_requests",
    "actual_requests",
    "results",
    "disclaimer",
    "gate_summary",
    "scenario_sha256",
    "target"
  ]
}
