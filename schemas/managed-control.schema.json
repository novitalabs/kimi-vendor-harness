{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "managed-control.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "revision", "updated_by", "run_id", "run_dir", "root", "endpoint", "nvst_args", "status", "phase", "started_at", "finished_at", "stdout_log", "stderr_log"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "updated_by": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "run_dir": {"type": "string", "minLength": 1},
    "root": {"type": "string", "minLength": 1},
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "served_model", "model_family", "think_mode", "headers"],
      "properties": {
        "base_url": {"type": "string", "pattern": "^https?://"},
        "served_model": {"type": "string", "minLength": 1},
        "model_family": {"type": "string", "minLength": 1},
        "think_mode": {"type": "string", "minLength": 1},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "nvst_args": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "status": {"enum": ["starting", "running", "pausing", "paused", "stopping", "stopped", "completed", "failed"]},
    "phase": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": ["string", "null"]},
    "stdout_log": {"type": "string", "minLength": 1},
    "stderr_log": {"type": "string", "minLength": 1},
    "heartbeat_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]},
    "worker_pid": {"type": ["integer", "null"], "minimum": 1},
    "process_group_id": {"type": ["integer", "null"], "minimum": 1},
    "child_pid": {"type": ["integer", "null"], "minimum": 1},
    "exit_code": {"type": ["integer", "null"]},
    "resuming": {"type": "boolean"},
    "supervisor": {"enum": ["systemd", "process_group"]},
    "unit_name": {"type": ["string", "null"]},
    "resource_cleanup": {"type": "object"}
  }
}
