{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "model_id", "family", "status", "features", "efforts", "authority", "notes"],
  "properties": {
    "schema_version": {"const": 2},
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "family": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "provisional"]},
    "features": {"type": "object", "additionalProperties": {"$ref": "#/$defs/claim"}},
    "efforts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/claim"}},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint", "encoder", "tokenizer", "api_contract", "stream_protocol", "unknowns"],
      "properties": {
        "checkpoint": {"type": ["string", "null"]}, "encoder": {"type": ["string", "null"]},
        "tokenizer": {"type": ["string", "null"]}, "api_contract": {"type": ["string", "null"]},
        "stream_protocol": {"enum": ["kimi-stream-244", null]},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["expectation", "evidence"],
      "properties": {
        "expectation": {"enum": ["required", "optional", "unsupported", "unknown"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [{"if": {"properties": {"expectation": {"enum": ["required", "optional", "unsupported"]}}}, "then": {"properties": {"evidence": {"minItems": 1}}}}]
    }
  }
}
