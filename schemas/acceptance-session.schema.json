{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance-session.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "updated_by", "session_id", "session_dir", "model", "service_access_path", "service_access_hash", "judge_access_path", "judge_access_hash", "requirements_snapshot_revision", "current_contract_hash", "current_suite_input_hashes", "runs", "contract_migrations", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "updated_by": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "session_dir": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "service_access_path": {"type": "string", "minLength": 1},
    "service_access_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "judge_access_path": {"type": ["string", "null"]},
    "judge_access_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "requirements_snapshot_revision": {"type": "string", "minLength": 1},
    "current_contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "current_suite_input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "runs": {"type": "array", "items": {"type": "object"}},
    "contract_migrations": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
