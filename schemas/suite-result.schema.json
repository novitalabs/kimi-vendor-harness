{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "suite-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "suite_id", "row_ids", "status", "validity", "counts",
    "metrics", "redacted_command", "artifact_paths", "failure_summary",
    "runner_fingerprint", "coverage", "reason", "started_at", "finished_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "row_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["passed", "failed", "blocked", "not_run", "not_implemented", "deferred"]},
    "validity": {"enum": ["valid", "service_invalid", "execution_invalid"]},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "metrics": {"type": "object"},
    "redacted_command": {"type": "array", "items": {"type": "string"}},
    "artifact_paths": {"type": "array", "items": {"type": "string"}},
    "failure_summary": {"type": ["string", "null"]},
    "runner_fingerprint": {"type": "object"},
    "coverage": {"type": "object"},
    "reason": {"type": ["string", "null"]},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]}
  }
}
